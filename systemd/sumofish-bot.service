[Unit]
Description=SumoFish lichess bot
Documentation=https://github.com/lichess-bot-devs/lichess-bot
After=network-online.target
Wants=network-online.target
# A crash loop that reconnects every 10s would burn through lichess rate limits.
# These are [Unit] keys, not [Service] keys.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/nomad/dev/active/sumofish/lichess-bot

# The OAuth token lives here, chmod 600, outside the repo and outside git.
# lichess-bot reads LICHESS_BOT_TOKEN and overrides the config.yml placeholder.
EnvironmentFile=/home/nomad/.config/sumofish/bot.env

# The simulation cap must not be what stops the search; the clock must.
# At 15+10 the engine is handed roughly 30s on the first move, which at ~2,500
# nodes/s is ~75,000 simulations -- close enough to the 100,000 default that it
# would start binding on long thinks, and a search stopped by an arbitrary
# counter is throwing away the time control we just paid for.
Environment=CHESSGPU_SIMS=100000000

# The Rust search. 3.6x faster, which is 4.5x more search on the same clock.
# This ships without a match behind it, which nothing else here is allowed to
# do, and the reason is that it is a FAITHFUL port: byte-identical root visit
# vectors to sumofish/mcts.py over 40 positions x 800 simulations at five batch
# sizes, across whole games with tree reuse, and re-checked with the real nets
# rather than the port's mock. Identical visits means identical moves, so there
# is no strength claim to measure -- only the clock changed.
#
# Rollback is `CHESSGPU_CORE=python` and a restart, not a revert.
Environment=CHESSGPU_CORE=rust

# NOT set, deliberately: CHESSGPU_DEDUP. It is faster per call and preserves the
# tree at a fixed simulation count, and BUNDLED WITH COMPILE it measured -168
# Elo at a fixed clock (2026-07-29, 20 games, W0 D11 L9, LOS 0.0%). At 0.5s the
# pair bought 7,297 nominal simulations against plain's 4,161 while getting
# 3,464 UNIQUE evaluations against plain's 4,160: 75% more claimed search, 17%
# less knowledge of the position. That mechanism is dedup's -- it collapses
# descents, so it can report search it did not do.
#
# CORRECTED 2026-08-15: the -168 was charged to both flags and belongs to one.
# Isolated over 600 games, compile is +92.5 +-14.6 and is set below. dedup on
# its own read +16.2 +-14.7 (LOS 0.985) but on a CONTENDED box, so it is
# unresolved rather than refuted, and it stays off until it is measured on an
# idle one. Do not turn it on because the nps number looks better; that is
# exactly the trap the paragraph above describes. See PHILOSOPHY, measurement
# discipline.

# The virtual-loss fix. It earned its default the way search_engine.py's own
# comment says it has to: a pair-match verdict, not a hunch. SPRT concluded
# "A is better" after 16 pairs (32 games), same checkpoint both arms, rust
# core, 400 sims, elo0=0 elo1=20 alpha=0.05 beta=0.05 (match.py's own
# defaults) -- LLR +7.46 against a +-2.94 bound, W25 D7 L0, LOS 100%, point
# estimate +364 Elo (+-213, wide at this n, but the direction and rough
# magnitude are not in doubt at zero losses). Run: runs/matches/vloss-fix-verify,
# 2026-07-30. See STATE.md and LAB-NOTES.md for the fuller record.
#
# Rollback is CHESSGPU_VLOSS_FIX=0 (or unset) and a restart, not a revert.
Environment=CHESSGPU_VLOSS_FIX=1
# Deployed 2026-08-15 on runs/matches/compile-time: 600 games, --time 0.5, seed
# 20260814, isolated (compile ONLY, not bundled with dedup), exclusive drained
# box. 178W 400D 22L, +92.5 +-14.6 Elo, LOS 100.0%. The per-game search record
# says why independently of the Elo: compile ON gets 1.6260 +-0.0039 of OFF's
# evaluations in the same wall clock.
#
# This RETIRES the -168 Elo that kept the flag off from 2026-07-30. That figure
# came from two arms of 20 games each, compile bundled with dedup in both, one
# of them named "contended". Forty games, never isolated, against an instrument
# this project's own philosophy prices at +-200 for 24 games. The diagnosed -168
# mechanism was dedup's (fake search via collapsed descents); compile sends the
# same rows and cannot buy fake search.
#
# Rollback is this one line: comment it out, `systemctl --user daemon-reload`,
# drain and restart. Note the engine couples pad_batches to this flag, and it
# MUST stay coupled: without padding the row count varies and CUDA graphs
# recapture every batch.
Environment=CHESSGPU_COMPILE=1

# NOT set: CHESSGPU_MATE_DISTANCE. Already correctly implemented (confirmed
# 2026-07-29), and as of 2026-08-13 confirmed SOUND against an exhaustive solver
# with the real nets (tests/verify_mate.py --real-nets: 34 proofs, 0 bogus, tree
# 52% smaller). It still has no pair-match verdict of its own, which is what the
# default turns on. runs/matches/mate-distance-400sims is that match. Note it is
# a FIXED-SIMULATION match and the fix's benefit is a smaller tree, i.e. a CLOCK
# gain, so that arm is a lower bound and a fixed-time arm is the one that
# answers deployment.

# NOT set: CHESSGPU_INSTAMOVE and CHESSGPU_EARLY_STOP. Added 2026-08-13 after
# scripts/operating_point.py measured that this engine spends 100% of its
# allowance on EVERY move and has never once taken under a second, across 336
# logged moves -- it thinks 19 seconds in positions with one legal reply.
#
#   CHESSGPU_INSTAMOVE   a forced move gets 50 ms instead of the full budget.
#                        Not zero: reroot() in rust/src/tree.rs declines after
#                        more than 2 plies, so skipping the search outright
#                        would discard the tree on the FOLLOWING move.
#   CHESSGPU_EARLY_STOP  stop once the runner-up cannot be caught even if every
#                        remaining simulation went to it. Conservative by
#                        construction and provably cannot change WHICH move is
#                        played (tests/verify_time_management.py pins the
#                        algebraic floor at 5/9 of the budget). Rust core only:
#                        sumofish.mcts.MCTS.search has no should_stop parameter,
#                        so it is gated as well as listed in RUST_ONLY_FLAGS, or
#                        a rollback to CHESSGPU_CORE=python would crash on move
#                        one rather than no-op.
#
# Same rule as everything else here: neither earns its default from being
# obviously right. Both need a match.

ExecStart=/home/nomad/dev/active/sumofish/.venv/bin/python lichess-bot.py

Restart=always
RestartSec=10

# lichess-bot installs a handler for SIGINT ONLY (lib/lichess_bot.py:100).
# There is no SIGTERM handler, so the default systemd stop signal killed it
# outright and `quit_after_all_games_finish: true` was inert -- every restart,
# including every scripts/promote.py run, abandoned whatever game was live.
# The user manager's default TimeoutStopSec is 10s, which is also far too
# short to drain a game, so both are set explicitly.
KillSignal=SIGINT
TimeoutStopSec=180

# Make the bot the last thing the kernel OOM-kills. Training peaks near 15.7G
# on a 31G box, and losing the live bot to reclaim memory for a batch is the
# wrong trade.
OOMScoreAdjust=-500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sumofish-bot

# Modest hardening. No sudo on this box, so this is all user-space.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
# lichess-bot writes lichess_bot_auto_logs/ into its working directory, which
# also holds per-game takeback state, so the whole dir has to be writable.
ReadWritePaths=/home/nomad/dev/active/sumofish/lichess-bot
ReadWritePaths=/home/nomad/dev/active/sumofish/logs
ReadWritePaths=/home/nomad/.local/state/sumofish

[Install]
WantedBy=default.target
