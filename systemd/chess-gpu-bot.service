[Unit]
Description=SumoFish lichess bot
Documentation=https://github.com/lichess-bot-devs/lichess-bot
After=network-online.target
Wants=network-online.target
# A crash loop that reconnects every 10s would burn through lichess rate limits.
# These are [Unit] keys, not [Service] keys.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/nomad/dev/active/chess-gpu/lichess-bot

# The OAuth token lives here, chmod 600, outside the repo and outside git.
# lichess-bot reads LICHESS_BOT_TOKEN and overrides the config.yml placeholder.
EnvironmentFile=/home/nomad/.config/chess-gpu/bot.env

# The simulation cap must not be what stops the search; the clock must.
# At 15+10 the engine is handed roughly 30s on the first move, which at ~2,500
# nodes/s is ~75,000 simulations -- close enough to the 100,000 default that it
# would start binding on long thinks, and a search stopped by an arbitrary
# counter is throwing away the time control we just paid for.
Environment=CHESSGPU_SIMS=100000000

# The Rust search. 3.6x faster, which is 4.5x more search on the same clock.
# This ships without a match behind it, which nothing else here is allowed to
# do, and the reason is that it is a FAITHFUL port: byte-identical root visit
# vectors to chessgpu/mcts.py over 40 positions x 800 simulations at five batch
# sizes, across whole games with tree reuse, and re-checked with the real nets
# rather than the port's mock. Identical visits means identical moves, so there
# is no strength claim to measure -- only the clock changed.
#
# Rollback is `CHESSGPU_CORE=python` and a restart, not a revert.
Environment=CHESSGPU_CORE=rust

# NOT set, deliberately: CHESSGPU_DEDUP and CHESSGPU_COMPILE. Both are faster
# per call and both preserve the tree at a fixed simulation count, and together
# they measured -168 Elo at a fixed clock (2026-07-29, 20 games, W0 D11 L9,
# LOS 0.0%). At 0.5s they bought 7,297 nominal simulations against plain's
# 4,161 while getting 3,464 UNIQUE evaluations against plain's 4,160: 75% more
# claimed search, 17% less knowledge of the position. Do not turn these on
# because the nps number looks better. See PHILOSOPHY, measurement discipline.

# The virtual-loss fix. It earned its default the way search_engine.py's own
# comment says it has to: a pair-match verdict, not a hunch. SPRT concluded
# "A is better" after 16 pairs (32 games), same checkpoint both arms, rust
# core, 400 sims, elo0=0 elo1=20 alpha=0.05 beta=0.05 (match.py's own
# defaults) -- LLR +7.46 against a +-2.94 bound, W25 D7 L0, LOS 100%, point
# estimate +364 Elo (+-213, wide at this n, but the direction and rough
# magnitude are not in doubt at zero losses). Run: runs/matches/vloss-fix-verify,
# 2026-07-30. See STATE.md and LAB-NOTES.md for the fuller record.
#
# Rollback is CHESSGPU_VLOSS_FIX=0 (or unset) and a restart, not a revert.
Environment=CHESSGPU_VLOSS_FIX=1

# NOT set: CHESSGPU_MATE_DISTANCE. Already correctly implemented (confirmed
# 2026-07-29), but it hasn't been through the pair-match harness on its own --
# only vloss_fix has a verdict so far. Same rule applies: earns its default
# from a match, not from "it's obviously correct."

ExecStart=/home/nomad/dev/active/chess-gpu/.venv/bin/python lichess-bot.py

Restart=always
RestartSec=10

# lichess-bot installs a handler for SIGINT ONLY (lib/lichess_bot.py:100).
# There is no SIGTERM handler, so the default systemd stop signal killed it
# outright and `quit_after_all_games_finish: true` was inert -- every restart,
# including every scripts/promote.py run, abandoned whatever game was live.
# The user manager's default TimeoutStopSec is 10s, which is also far too
# short to drain a game, so both are set explicitly.
KillSignal=SIGINT
TimeoutStopSec=180

# Make the bot the last thing the kernel OOM-kills. Training peaks near 15.7G
# on a 31G box, and losing the live bot to reclaim memory for a batch is the
# wrong trade.
OOMScoreAdjust=-500

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chess-gpu-bot

# Modest hardening. No sudo on this box, so this is all user-space.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
# lichess-bot writes lichess_bot_auto_logs/ into its working directory, which
# also holds per-game takeback state, so the whole dir has to be writable.
ReadWritePaths=/home/nomad/dev/active/chess-gpu/lichess-bot
ReadWritePaths=/home/nomad/dev/active/chess-gpu/logs
ReadWritePaths=/home/nomad/.local/state/chess-gpu

[Install]
WantedBy=default.target
