[Unit]
Description=SumoFish lichess bot
Documentation=https://github.com/lichess-bot-devs/lichess-bot
After=network-online.target
Wants=network-online.target
# A crash loop that reconnects every 10s would burn through lichess rate limits.
# These are [Unit] keys, not [Service] keys.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/nomad/chess-gpu/lichess-bot

# The OAuth token lives here, chmod 600, outside the repo and outside git.
# lichess-bot reads LICHESS_BOT_TOKEN and overrides the config.yml placeholder.
EnvironmentFile=/home/nomad/.config/chess-gpu/bot.env

ExecStart=/home/nomad/chess-gpu/.venv/bin/python lichess-bot.py

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chess-gpu-bot

# Modest hardening. No sudo on this box, so this is all user-space.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
# lichess-bot writes lichess_bot_auto_logs/ into its working directory, which
# also holds per-game takeback state, so the whole dir has to be writable.
ReadWritePaths=/home/nomad/chess-gpu/lichess-bot
ReadWritePaths=/home/nomad/chess-gpu/logs
ReadWritePaths=/home/nomad/.local/state/chess-gpu

[Install]
WantedBy=default.target
