[Unit]
Description=SumoFish training run (9M, state value + HL-Gauss)
After=network-online.target
# A genuinely broken config would otherwise restart forever and look healthy.
StartLimitIntervalSec=1800
StartLimitBurst=8

[Service]
Type=simple
WorkingDirectory=/home/nomad/chess-gpu

# systemd-inhibit blocks suspend/idle for the life of the run. No idle action is
# configured on this box today, but a KDE power-profile change eight hours from
# now should not be able to kill the run.
ExecStart=/usr/bin/systemd-inhibit \
    --what=sleep:idle:handle-lid-switch \
    --who=chess-gpu \
    --why="training run in progress" \
    /home/nomad/chess-gpu/.venv/bin/python train.py \
        --target state_value --value-bins 64 \
        --init-from runs/9M-causal/best.pt \
        --preset 9M --steps 300000 --batch-size 1024 --workers 10 \
        --lr 3e-4 --warmup 2000 \
        --log-every 200 --eval-every 10000 --eval-puzzles 1000 --ckpt-every 5000 \
        --compile 1 --run 9M-sv-warm-full --auto-resume

# on-failure, not always: train.py exits 0 when it finishes, and restarting a
# completed run would silently begin a second one.
Restart=on-failure
RestartSec=30

# SIGTERM makes train.py finish its step, run a final eval, and checkpoint.
# That eval takes real time, so do not kill it halfway.
KillSignal=SIGTERM
TimeoutStopSec=420

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chess-gpu-train

Nice=-5

[Install]
WantedBy=default.target
