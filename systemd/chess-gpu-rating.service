[Unit]
Description=Sample SumoFish's lichess rating

[Service]
Type=oneshot
WorkingDirectory=/home/nomad/dev/active/chess-gpu
ExecStart=/home/nomad/dev/active/chess-gpu/.venv/bin/python /home/nomad/dev/active/chess-gpu/scripts/rating_log.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chess-gpu-rating
