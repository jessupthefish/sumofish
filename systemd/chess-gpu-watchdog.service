[Unit]
Description=chess-gpu bot watchdog (detects silently-stalled games)
After=chess-gpu-bot.service

[Service]
Type=oneshot
EnvironmentFile=/home/nomad/.config/chess-gpu/bot.env
ExecStart=/home/nomad/dev/active/chess-gpu/.venv/bin/python /home/nomad/dev/active/chess-gpu/scripts/watchdog.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chess-gpu-watchdog
